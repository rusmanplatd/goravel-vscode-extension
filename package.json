{
  "name": "goravel-vscode",
  "displayName": "Goravel",
  "description": "Goravel tooling: raw SQL LSP, ORM query builder intelligence, Config, Routes, Validation Rules, and Artisan CLI for Go projects",
  "version": "0.6.0",
  "publisher": "rusmanplatd",
  "repository": {
    "type": "git",
    "url": "https://github.com/rusmanplatd/goravel-vscode-extension.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:artisan",
    "workspaceContains:app/models"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Goravel",
      "properties": {
        "goravel.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the goravel-lsp binary. Defaults to the bundled bin/goravel-lsp."
        },
        "goravel.sql.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Goravel Raw SQL and Framework intelligence inside Go files."
        },
        "goravel.sql.liveIntrospection": {
          "type": "boolean",
          "default": false,
          "description": "Enable optional live database schema introspection using .env DB_* settings."
        },
        "goravel.artisan.command": {
          "type": "string",
          "default": "go run . artisan",
          "description": "Base Artisan CLI command prefix (e.g. 'go run . artisan', './artisan', or 'docker compose exec app go run . artisan')."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "goravel-explorer",
          "title": "Goravel",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "goravel-explorer": [
        {
          "id": "goravel.views.models",
          "name": "Models & Schema"
        },
        {
          "id": "goravel.views.routes",
          "name": "Routes"
        },
        {
          "id": "goravel.views.migrations",
          "name": "Migrations"
        },
        {
          "id": "goravel.views.commands",
          "name": "Commands, Seeders & Schedules"
        }
      ]
    },
    "commands": [
      {
        "command": "goravel.restartServer",
        "title": "Goravel: Restart Language Server"
      },
      {
        "command": "goravel.refreshViews",
        "title": "Goravel: Refresh Sidebar Views",
        "icon": "$(refresh)"
      },
      {
        "command": "goravel.showErDiagram",
        "title": "Goravel: Show Database ER Diagram",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "goravel.showRouteMatrix",
        "title": "Goravel: Show Route Matrix",
        "icon": "$(table)"
      },
      {
        "command": "goravel.registerBootstrap",
        "title": "Goravel: Register in bootstrap/",
        "icon": "$(add)"
      },
      {
        "command": "goravel.model.openMigration",
        "title": "Goravel: Open Table Migration",
        "icon": "$(file-code)"
      },
      {
        "command": "goravel.table.preview",
        "title": "Goravel: Preview Table Data (Top 20)",
        "icon": "$(eye)"
      },
      {
        "command": "goravel.route.openDefinition",
        "title": "Goravel: Open Route Registration",
        "icon": "$(go-to-file)"
      },
      {
        "command": "goravel.route.testRequest",
        "title": "Goravel: Test Route Request",
        "icon": "$(send)"
      },
      {
        "command": "goravel.artisan.run",
        "title": "Goravel: Run Artisan Command..."
      },
      {
        "command": "goravel.artisan.makeModel",
        "title": "Goravel: Artisan make:model"
      },
      {
        "command": "goravel.artisan.makeController",
        "title": "Goravel: Artisan make:controller"
      },
      {
        "command": "goravel.artisan.makeMigration",
        "title": "Goravel: Artisan make:migration"
      },
      {
        "command": "goravel.artisan.makeRequest",
        "title": "Goravel: Artisan make:request"
      },
      {
        "command": "goravel.artisan.makeRule",
        "title": "Goravel: Artisan make:rule"
      },
      {
        "command": "goravel.artisan.makeSeeder",
        "title": "Goravel: Artisan make:seeder"
      },
      {
        "command": "goravel.artisan.makeEvent",
        "title": "Goravel: Artisan make:event"
      },
      {
        "command": "goravel.artisan.makeListener",
        "title": "Goravel: Artisan make:listener"
      },
      {
        "command": "goravel.artisan.makeJob",
        "title": "Goravel: Artisan make:job"
      },
      {
        "command": "goravel.artisan.makeObserver",
        "title": "Goravel: Artisan make:observer"
      },
      {
        "command": "goravel.artisan.makePolicy",
        "title": "Goravel: Artisan make:policy"
      },
      {
        "command": "goravel.artisan.makeProvider",
        "title": "Goravel: Artisan make:provider"
      },
      {
        "command": "goravel.artisan.makeFactory",
        "title": "Goravel: Artisan make:factory"
      },
      {
        "command": "goravel.artisan.makeTest",
        "title": "Goravel: Artisan make:test"
      },
      {
        "command": "goravel.artisan.migrate",
        "title": "Goravel: Artisan migrate"
      },
      {
        "command": "goravel.artisan.migrateRollback",
        "title": "Goravel: Artisan migrate:rollback"
      },
      {
        "command": "goravel.artisan.seedSpecific",
        "title": "Goravel: Artisan db:seed..."
      },
      {
        "command": "goravel.logs.open",
        "title": "Goravel: Open storage/logs/goravel.log"
      },
      {
        "command": "goravel.test.run",
        "title": "Goravel: Run Go Test"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "goravel.showErDiagram",
          "when": "view == goravel.views.models",
          "group": "navigation@1"
        },
        {
          "command": "goravel.showRouteMatrix",
          "when": "view == goravel.views.routes",
          "group": "navigation@1"
        },
        {
          "command": "goravel.refreshViews",
          "when": "view =~ /^goravel\\.views\\./",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "goravel.table.preview",
          "when": "view == goravel.views.models && viewItem == goravelTable",
          "group": "inline@1"
        },
        {
          "command": "goravel.model.openMigration",
          "when": "view == goravel.views.models && viewItem == goravelTable",
          "group": "inline@2"
        },
        {
          "command": "goravel.route.testRequest",
          "when": "view == goravel.views.routes && viewItem == goravelRoute",
          "group": "inline@1"
        },
        {
          "command": "goravel.route.openDefinition",
          "when": "view == goravel.views.routes && viewItem == goravelRoute",
          "group": "inline@2"
        },
        {
          "command": "goravel.registerBootstrap",
          "when": "view == goravel.views.commands && viewItem == goravelUnregistered",
          "group": "inline@1"
        }
      ],
      "explorer/context": [
        {
          "command": "goravel.artisan.makeModel",
          "when": "resourcePath =~ /\\/app\\/models$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeController",
          "when": "resourcePath =~ /\\/app\\/http\\/controllers$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeRequest",
          "when": "resourcePath =~ /\\/app\\/http\\/requests$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeRule",
          "when": "resourcePath =~ /\\/app\\/rules$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeEvent",
          "when": "resourcePath =~ /\\/app\\/events$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeListener",
          "when": "resourcePath =~ /\\/app\\/listeners$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeJob",
          "when": "resourcePath =~ /\\/app\\/jobs$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeObserver",
          "when": "resourcePath =~ /\\/app\\/observers$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makePolicy",
          "when": "resourcePath =~ /\\/app\\/policies$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeProvider",
          "when": "resourcePath =~ /\\/app\\/providers$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeMigration",
          "when": "resourcePath =~ /\\/database\\/migrations([_a-zA-Z0-9-]*)(\\/|$)/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeSeeder",
          "when": "resourcePath =~ /\\/database\\/seeders$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeFactory",
          "when": "resourcePath =~ /\\/database\\/factories$/",
          "group": "goravel@1"
        },
        {
          "command": "goravel.artisan.makeTest",
          "when": "resourcePath =~ /\\/tests$/",
          "group": "goravel@1"
        }
      ]
    },
    "snippets": [
      {
        "language": "go",
        "path": "./snippets/goravel.code-snippets"
      }
    ],
    "grammars": [
      {
        "scopeName": "goravel-sql.injection",
        "path": "./syntaxes/goravel-sql.injection.tmLanguage.json",
        "injectTo": [
          "source.go"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.sql": "sql"
        }
      }
    ]
  },
  "scripts": {
    "build:server": "cd server && go build -o ../bin/goravel-lsp .",
    "install:server": "cd server && go install .",
    "build:client": "esbuild client/src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build": "npm run build:server && npm run build:client",
    "test:server": "cd server && go test ./...",
    "typecheck": "tsc --noEmit -p .",
    "vscode:prepublish": "npm run build",
    "package": "npm run typecheck && npm run test:server && vsce package --out dist/",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}